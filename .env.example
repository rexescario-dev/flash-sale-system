# Development configuration only. Copy to `.env` for local runs.
# Never commit real secrets.

# These localhost values are used for local configuration outside the Compose network.
# When running the full Docker Compose stack, Compose overrides DATABASE_URL,
# REDIS_URL, and API PORT=3000 for the api/migrate containers.
# Containers use Compose service DNS:
#   PostgreSQL: postgres:5432
#   Redis: redis:6379

# PostgreSQL
POSTGRES_USER=flash_sale
POSTGRES_PASSWORD=flash_sale_dev
POSTGRES_DB=flash_sale
DATABASE_URL=postgresql://flash_sale:flash_sale_dev@localhost:5432/flash_sale

# Redis (non-authoritative; fail-open if unavailable)
REDIS_URL=redis://localhost:6379

# Cache TTLs (seconds)
FLASH_SALE_CACHE_TTL_SECONDS=5
MY_PURCHASE_CACHE_TTL_SECONDS=5
MY_PURCHASE_NEGATIVE_CACHE_TTL_SECONDS=2

# purchaseItem fixed-window rate limit (per client IP)
RATE_LIMIT_PURCHASE_ITEM_MAX=30
RATE_LIMIT_PURCHASE_ITEM_WINDOW_SECONDS=60

# When true, Express trust proxy hop count is 1 and req.ip is used for rate limiting
TRUSTED_PROXY=false

# API
PORT=3000
NODE_ENV=development

# Web (VITE_* values are exposed to the browser — never put secrets here)
VITE_API_URL=http://localhost:3000
