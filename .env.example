# Development configuration only. Copy to `.env` for local runs.
# Never commit real secrets.

# PostgreSQL (Docker Compose)
POSTGRES_USER=flash_sale
POSTGRES_PASSWORD=flash_sale_dev
POSTGRES_DB=flash_sale
DATABASE_URL=postgresql://flash_sale:flash_sale_dev@localhost:5432/flash_sale

# Redis (Compose service is available; Redis client integration is deferred to EPIC-04)
REDIS_URL=redis://localhost:6379

# API
PORT=3000
NODE_ENV=development

# Web (VITE_* values are exposed to the browser — never put secrets here)
VITE_API_URL=http://localhost:3000
